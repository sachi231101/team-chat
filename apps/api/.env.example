# ─────────────────────────────────────────────────────────────────
# Team Chat API — Environment Variables
# Copy this file to .env and fill in your own values.
# DO NOT commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── PostgreSQL ────────────────────────────────────────────────────
# Full connection string (recommended)
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/teamchat?schema=public"

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── CORS ──────────────────────────────────────────────────────────
# HTTP server reads ALLOWED_ORIGINS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
# WebSocket gateway reads CORS_ORIGIN (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# ── JWT / Auth (for future Workplace platform integration) ────────
# JWT_SECRET=replace_with_a_long_random_secret

# ── Storage (for file attachments — not yet implemented) ─────────
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
