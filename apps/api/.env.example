# ─────────────────────────────────────────────────────────────────
# Team Chat API — Environment Variables
# Copy this file to .env and fill in your own values.
# DO NOT commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── PostgreSQL ────────────────────────────────────────────────────
# Matches docker-compose.yml (pnpm docker:up)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teamchat?schema=public"

# ── CORS (HTTP + WebSocket) ───────────────────────────────────────
# Comma-separated origins. Used by both REST and Socket.IO.
# Include http://localhost when using the Nginx stack (pnpm docker:stack).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001,http://localhost,http://127.0.0.1

# ── JWT / Auth (for future Workplace platform integration) ────────
# JWT_SECRET=replace_with_a_long_random_secret
# SESSION_SECRET=replace_with_a_long_random_secret
# SESSION_ENABLED=false

# ── AI (Gemini now; OpenAI / Anthropic ready for production) ──────
# Put keys in .env only. Never commit secrets.
AI_ENABLED=true
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_MAX_CONTEXT_MESSAGES=20
AI_MAX_TOKENS=2048
AI_REQUEST_TIMEOUT_MS=30000

# Production later — flip AI_PROVIDER and implement the matching provider:
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Redis ────────────────────────────────────────────────────────────
# pnpm docker:up publishes Redis on localhost:6379.
# If Redis is unreachable and REDIS_REQUIRED is unset, Socket.IO falls back to in-memory.
REDIS_URL="redis://localhost:6379"
REDIS_CONNECT_TIMEOUT_MS=3000
# REDIS_REQUIRED=true
# TRUST_PROXY=true

# ── S3 (optional) ────────────────────────────────────────────────
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── Temporary mock identity (header-based) ────────────────────────
# Development uses x-user-id / x-workplace-id. Workplace auth will replace this.
# ALLOW_MOCK_IDENTITY=true
