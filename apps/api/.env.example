# ─────────────────────────────────────────────────────────────────
# Team Chat API — Environment Variables
# Copy this file to .env and fill in your own values.
# See ../../INTEGRATION.md for Workplace Platform alignment.
# ─────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── PostgreSQL ────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teamchat?schema=public"

# ── Workplace Platform integration ───────────────────────────────
SHARED_JWT_SECRET=workplace_platform_shared_product_launch_jwt_secret_2026
WORKPLACE_PLATFORM_URL=http://localhost:3000
PLATFORM_VERIFY_TIMEOUT_MS=5000

# ── CORS (HTTP + WebSocket) ───────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001,http://localhost:3000,http://127.0.0.1:5173

# ── Mock identity (dev standalone only — disable in production) ───
# ALLOW_MOCK_IDENTITY=true

# ── Session (optional, not used for auth) ─────────────────────────
# SESSION_SECRET=replace_with_a_long_random_secret
# SESSION_ENABLED=false

# ── AI ────────────────────────────────────────────────────────────
AI_ENABLED=true
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
REDIS_CONNECT_TIMEOUT_MS=3000

# ── Reverse proxy ─────────────────────────────────────────────────
# TRUST_PROXY=true
