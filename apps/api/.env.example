# ─────────────────────────────────────────────────────────────────
# Team Chat API — Environment Variables
# Copy this file to .env and fill in your own values.
# DO NOT commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── PostgreSQL ────────────────────────────────────────────────────
# Matches docker-compose.yml (pnpm docker:up)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teamchat?schema=public"

# ── CORS (HTTP + WebSocket) ───────────────────────────────────────
# Comma-separated origins. Used by both REST and Socket.IO.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# ── JWT / Auth (for future Workplace platform integration) ────────
# JWT_SECRET=replace_with_a_long_random_secret

# ── AI (NVIDIA Integrate / OpenAI-compatible) ─────────────────────
# Put the key in .env only. Never commit secrets.
AI_ENABLED=true
AI_PROVIDER=nvidia
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_API_KEY=
# Model id must exist on NVIDIA Integrate (404 = wrong / retired model name).
# Examples: meta/llama-3.1-8b-instruct  |  nvidia/llama-3.1-nemotron-70b-instruct
AI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
AI_MAX_CONTEXT_MESSAGES=20
AI_MAX_TOKENS=2048

# ── Redis / S3 (deferred until core chat is solid) ────────────────
# Optional. If set but Redis is unreachable, API falls back to in-memory Socket.IO after timeout.
# REDIS_URL="redis://localhost:6379"
# REDIS_CONNECT_TIMEOUT_MS=3000
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── Temporary mock identity (header-based) ────────────────────────
# Development uses x-user-id / x-workplace-id. Workplace auth will replace this.
# ALLOW_MOCK_IDENTITY=true
