{
  "name": "team-chat-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Team Chat Platform monorepo",
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "docker:up": "docker compose up -d postgres redis",
    "docker:stack": "docker compose --profile stack up -d --build",
    "docker:scale": "docker compose --profile stack up -d --scale identity-api=2 --scale workplace-api=2 --scale team-chat-api=2",
    "docker:down": "docker compose --profile stack down",
    "prisma:generate": "pnpm --filter api prisma:generate",
    "prisma:migrate": "pnpm --filter api prisma:migrate",
    "test": "pnpm --filter api test",
    "typecheck": "pnpm --recursive exec tsc --noEmit"
  },
  "keywords": [
    "team-chat",
    "chat",
    "monorepo",
    "react",
    "nestjs",
    "prisma",
    "socketio"
  ],
  "author": "",
  "license": "ISC"
}
